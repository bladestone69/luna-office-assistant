# App
HOSTLINE_ADMIN_PASSWORD=change-me
HOSTLINE_SESSION_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3001

# xAI / Grok Voice Agent
# Get a key at https://console.x.ai
XAI_API_KEY=xai-...
# Agent id from Voice Agent Builder (https://console.x.ai/voice/agents)
XAI_AGENT_ID=
# Optional: phone number provisioned in Voice Agent Builder
XAI_PHONE_NUMBER=
# Shared secret for tool webhooks from your Grok agent tools
XAI_WEBHOOK_SECRET=replace-with-shared-secret
