{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/webhooks/xai/sip/route.ts": {
      "maxDuration": 300
    },
    "app/api/client/ask/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/calls/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/calls",
      "schedule": "* * * * *"
    }
  ]
}
