{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p aura-paused && printf '%s' '<!doctype html><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Aura Office</title><h1>Aura Office is temporarily paused</h1>' > aura-paused/index.html",
  "outputDirectory": "aura-paused",
  "crons": [],
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    }
  ]
}
